<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NETO Inventario</title>
    
    <!-- ===== PWA METADATA CORREGIDA ===== -->
    <link rel="manifest" href="/Invetario_neto/manifest.json">
    <meta name="theme-color" content="#1e3a8a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="NETO Inventario">
    
    <!-- Icono para Apple (usando SVG embebido) -->
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='100' fill='%231a237e'/%3E%3Ctext x='256' y='320' font-family='Arial' font-size='180' font-weight='bold' fill='%23ff6f00' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/Invetario_neto/css/styles.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ===== TODOS LOS ESTILOS ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            color: #1a237e;
            padding-bottom: 20px;
            -webkit-font-smoothing: antialiased;
        }
        
        :root {
            --primary-blue: #1a237e;
            --primary-orange: #ff6f00;
            --light-blue: #e8eaf6;
            --light-orange: #fff3e0;
            --text-light: #ffffff;
            --shadow: 0 2px 8px rgba(0,0,0,0.1);
            --border-radius: 10px;
        }
        
        .container {
            max-width: 480px;
            margin: 0 auto;
            padding: 10px;
        }
        
        .header {
            background: var(--primary-blue);
            color: var(--text-light);
            padding: 15px;
            text-align: center;
            border-radius: var(--border-radius);
            margin-bottom: 15px;
            box-shadow: var(--shadow);
        }
        
        .header h1 {
            font-size: 20px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        .header .subtitle {
            font-size: 12px;
            opacity: 0.8;
            margin-top: 4px;
        }
        
        .main-menu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin: 15px 0;
        }
        
        .menu-item {
            background: white;
            padding: 20px 10px;
            border-radius: var(--border-radius);
            text-align: center;
            cursor: pointer;
            box-shadow: var(--shadow);
            border: 2px solid transparent;
            transition: all 0.15s;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        
        .menu-item:active {
            transform: scale(0.95);
            background: var(--light-blue);
        }
        
        .menu-item .icon {
            font-size: 28px;
            margin-bottom: 5px;
        }
        
        .menu-item .label {
            font-size: 14px;
            font-weight: 500;
            color: var(--primary-blue);
        }
        
        .menu-item.orange {
            border-color: var(--primary-orange);
        }
        
        .menu-item.orange .label {
            color: var(--primary-orange);
        }
        
        .menu-item.full-width {
            grid-column: span 2;
        }
        
        .badge-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--primary-orange);
            color: white;
            border-radius: 50%;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: bold;
            min-width: 20px;
        }
        
        .screen {
            display: none;
            animation: fadeIn 0.25s ease;
        }
        
        .screen.active {
            display: block;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
            width: 100%;
            text-align: center;
            margin: 5px 0;
        }
        
        .btn:active {
            transform: scale(0.97);
        }
        
        .btn-primary {
            background: var(--primary-blue);
            color: white;
        }
        
        .btn-orange {
            background: var(--primary-orange);
            color: white;
        }
        
        .btn-secondary {
            background: var(--light-blue);
            color: var(--primary-blue);
        }
        
        .btn-danger {
            background: #d32f2f;
            color: white;
        }
        
        .btn-success {
            background: #2e7d32;
            color: white;
        }
        
        .btn-back {
            background: transparent;
            color: var(--primary-blue);
            text-align: left;
            padding: 8px 0;
            font-size: 16px;
            width: auto;
            margin: 0 0 8px 0;
        }
        
        .btn-scan {
            font-size: 16px;
            padding: 14px;
            margin-top: 8px;
        }
        
        .btn-sm {
            padding: 4px 12px;
            font-size: 18px;
            width: auto;
            min-width: 36px;
            line-height: 1.4;
            margin: 0;
        }
        
        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .btn-group .btn {
            flex: 1;
            min-width: 80px;
        }
        
        .card {
            background: white;
            border-radius: var(--border-radius);
            padding: 15px;
            margin: 10px 0;
            box-shadow: var(--shadow);
        }
        
        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 10px;
            border-bottom: 2px solid var(--light-blue);
            padding-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .count-badge {
            font-size: 13px;
            font-weight: normal;
            background: var(--light-blue);
            padding: 2px 12px;
            border-radius: 20px;
            color: var(--primary-blue);
        }
        
        .form-group {
            margin: 12px 0;
        }
        
        .form-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 500;
            color: var(--primary-blue);
            margin-bottom: 4px;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
            background: white;
            transition: border-color 0.2s;
            font-family: inherit;
        }
        
        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(26, 35, 126, 0.1);
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 60px;
        }
        
        .barcode-input {
            font-size: 18px !important;
            letter-spacing: 1px;
            background: var(--light-blue) !important;
            border-color: var(--primary-blue) !important;
            font-family: 'Courier New', monospace !important;
            text-align: center;
        }
        
        .scan-area {
            background: var(--light-blue);
            border: 2px dashed var(--primary-blue);
            padding: 20px;
            text-align: center;
            border-radius: var(--border-radius);
            margin: 10px 0;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .scan-area:active {
            transform: scale(0.98);
        }
        
        .scan-area .scan-icon {
            font-size: 32px;
            display: block;
            margin-bottom: 8px;
            color: var(--primary-blue);
        }
        
        .scan-area .scan-hint {
            font-size: 13px;
            color: var(--primary-blue);
            display: block;
            margin-bottom: 10px;
        }
        
        .scan-area input {
            width: 100%;
            padding: 14px;
            font-size: 18px;
            border: 2px solid var(--primary-blue);
            border-radius: 8px;
            text-align: center;
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
            background: white;
            margin: 8px 0;
        }
        
        .scan-area-orange {
            border-color: var(--primary-orange);
            background: var(--light-orange);
        }
        
        .scan-area-orange .scan-icon {
            color: var(--primary-orange);
        }
        
        .scan-area-orange .scan-hint {
            color: var(--primary-orange);
        }
        
        .product-list-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            background: #f9f9f9;
            border-radius: 8px;
            margin: 6px 0;
            border-left: 4px solid var(--primary-blue);
            transition: all 0.15s;
        }
        
        .product-list-item .product-info {
            flex: 1;
            min-width: 0;
        }
        
        .product-list-item .product-info .name {
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .product-list-item .product-info .barcode {
            font-size: 12px;
            color: #666;
            font-family: 'Courier New', monospace;
        }
        
        .product-list-item .product-actions {
            display: flex;
            gap: 5px;
            align-items: center;
            flex-shrink: 0;
        }
        
        .product-list-item .product-actions .count-display {
            font-size: 20px;
            font-weight: bold;
            min-width: 30px;
            text-align: center;
            color: var(--primary-orange);
        }
        
        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
            white-space: nowrap;
        }
        
        .badge-success {
            background: #4caf50;
            color: white;
        }
        
        .badge-warning {
            background: var(--primary-orange);
            color: white;
        }
        
        .badge-danger {
            background: #d32f2f;
            color: white;
        }
        
        .badge-info {
            background: var(--primary-blue);
            color: white;
        }
        
        .barcode-badge {
            background: #f5f5f5;
            padding: 4px 10px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 11px;
            color: #666;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }
        
        .stat-card {
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        
        .stat-card.blue {
            background: var(--light-blue);
        }
        
        .stat-card.orange {
            background: var(--light-orange);
        }
        
        .stat-card.green {
            background: #e8f5e9;
        }
        
        .stat-card .stat-icon {
            font-size: 24px;
            margin-bottom: 4px;
        }
        
        .stat-card .stat-number {
            font-size: 24px;
            font-weight: bold;
        }
        
        .stat-card.blue .stat-number {
            color: var(--primary-blue);
        }
        
        .stat-card.orange .stat-number {
            color: var(--primary-orange);
        }
        
        .stat-card.green .stat-number {
            color: #2e7d32;
        }
        
        .stat-card .stat-label {
            font-size: 11px;
            color: #666;
        }
        
        .hidden {
            display: none !important;
        }
        
        .scrollable {
            max-height: 400px;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        
        .empty-message {
            color: #666;
            font-size: 13px;
            text-align: center;
            padding: 20px;
        }
        
        .divider {
            text-align: center;
            color: #999;
            font-size: 13px;
            margin: 12px 0;
            position: relative;
        }
        
        .divider::before,
        .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 30%;
            height: 1px;
            background: #ddd;
        }
        
        .divider::before { left: 0; }
        .divider::after { right: 0; }
        
        .help-text {
            font-size: 13px;
            color: #666;
            margin-bottom: 10px;
        }
        
        .info-card {
            background: var(--light-orange);
            border-left: 4px solid var(--primary-orange);
        }
        
        .info-card .info-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .info-card .info-title {
            font-size: 13px;
            color: var(--primary-blue);
            font-weight: 500;
        }
        
        .info-card .info-subtitle {
            font-size: 12px;
            color: #666;
        }
        
        .fab-scan {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--primary-orange);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            font-size: 28px;
            box-shadow: 0 4px 16px rgba(255, 111, 0, 0.4);
            cursor: pointer;
            z-index: 1000;
            transition: all 0.2s;
            display: none;
            align-items: center;
            justify-content: center;
        }
        
        .fab-scan:active {
            transform: scale(0.9);
        }
        
        .fab-scan.show {
            display: flex;
        }
        
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin: 10px 0;
            font-size: 14px;
        }
        
        .alert-success {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
        }
        
        .alert-danger {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ef9a9a;
        }
        
        .alert-warning {
            background: #fff3e0;
            color: #e65100;
            border: 1px solid #ffcc80;
        }
        
        .alert-info {
            background: var(--light-blue);
            color: var(--primary-blue);
            border: 1px solid #9fa8da;
        }
        
        input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 2px dashed #ddd;
            border-radius: 8px;
            background: #fafafa;
            margin: 8px 0;
            cursor: pointer;
        }
        
        @media (max-width: 400px) {
            .main-menu {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }
            
            .menu-item {
                padding: 14px 8px;
                min-height: 60px;
            }
            
            .menu-item .icon {
                font-size: 22px;
            }
            
            .menu-item .label {
                font-size: 12px;
            }
            
            .form-group input,
            .form-group textarea {
                font-size: 14px;
                padding: 10px;
            }
            
            .scan-area input {
                font-size: 16px;
                padding: 10px;
            }
            
            .stats-grid {
                grid-template-columns: 1fr 1fr 1fr;
                gap: 6px;
            }
            
            .stat-card {
                padding: 10px;
            }
            
            .stat-card .stat-number {
                font-size: 20px;
            }
        }
        
        @media (min-width: 768px) {
            .container {
                max-width: 560px;
                padding: 20px;
            }
        }
        
        .android-performance {
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            will-change: transform;
        }
        
        .android-performance .menu-item,
        .android-performance .btn {
            transition: none !important;
        }
        
        .promo-card.selected {
            border-color: #f97316 !important;
            background-color: #1e293b !important;
            box-shadow: 0 0 20px rgba(249, 115, 22, 0.2);
            transform: translateY(-2px);
            border-width: 2px !important;
        }
        
        .neto-dark {
            background: #0f172a;
        }
        
        .neto-input {
            background: #0f172a;
            border: 1px solid #334155;
            color: #e2e8f0;
            transition: all 0.2s ease;
        }
        
        .neto-input:focus {
            outline: none;
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.2);
        }
        
        .neto-input::placeholder {
            color: #64748b;
        }
        
        .promo-card {
            transition: all 0.2s ease;
        }
        
        .promo-card:hover {
            transform: translateY(-1px);
            border-color: #475569;
        }
        
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        
        ::-webkit-scrollbar-track {
            background: #1e293b;
            border-radius: 4px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #f97316;
            border-radius: 4px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #ea580c;
        }
        
        @media (max-width: 400px) {
            .promo-card {
                padding: 8px !important;
            }
        }
    </style>
</head>
<body>

<!-- ===== TOAST NOTIFICATION ===== -->
<div id="toastContainer" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-11/12 max-w-sm pointer-events-none transition-all duration-300 opacity-0 translate-y-[-20px]">
    <div id="toastContent" class="bg-slate-900 text-white border border-orange-500 rounded-xl p-4 shadow-2xl flex items-center gap-3 text-xs font-semibold">
        <span id="toastIcon" class="text-lg">ℹ️</span>
        <span id="toastMessage" class="flex-1">Notificación</span>
    </div>
</div>

<div class="container">
    <!-- HEADER -->
    <header class="header">
        <h1>📦 NETO Inventario</h1>
        <p class="subtitle">🔍 Sistema Integral de Gestión</p>
    </header>

    <!-- BOTÓN FLOTANTE -->
    <button class="fab-scan" id="fabScan" onclick="activarEscaneo()">
        <i class="fas fa-camera"></i>
    </button>

    <!-- ========== PANTALLA DE INICIO ========== -->
    <section id="screen-home" class="screen active">
        <div class="main-menu">
            <div class="menu-item orange" onclick="showScreen('promociones')">
                <span class="icon"><i class="fas fa-tags"></i></span>
                <span class="label">🏷️ Promociones</span>
                <span class="badge-count" id="badge-promo">0</span>
            </div>
            <div class="menu-item" onclick="showScreen('caducidades')">
                <span class="icon"><i class="fas fa-clock"></i></span>
                <span class="label">⏰ Caducidades</span>
                <span class="badge-count" id="badge-cad">0</span>
            </div>
            <div class="menu-item orange" onclick="showScreen('ciclicos')">
                <span class="icon"><i class="fas fa-sync-alt"></i></span>
                <span class="label">🔄 Conteo Cíclico</span>
            </div>
            <div class="menu-item" onclick="showScreen('inventario')">
                <span class="icon"><i class="fas fa-chart-bar"></i></span>
                <span class="label">📊 Inventario</span>
            </div>
            <div class="menu-item full-width" onclick="showScreen('visual')">
                <span class="icon"><i class="fas fa-eye"></i></span>
                <span class="label">👁️ Visualización General</span>
            </div>
        </div>
        
        <button class="btn btn-orange btn-scan" onclick="activarEscaneo()">
            <i class="fas fa-camera"></i> Escanear Código de Barras
        </button>
        
        <button id="btnInstalarApp" onclick="instalarApp()" class="btn btn-secondary" style="margin-top: 10px;">
            <i class="fas fa-download"></i> Instalar App
        </button>
    </section>

    <!-- ========== PANTALLA: PROMOCIONES ========== -->
    <section id="screen-promociones" class="screen">
        <button class="btn btn-back" onclick="showScreen('home')">
            <i class="fas fa-arrow-left"></i> Volver
        </button>
        
        <div class="neto-dark rounded-3xl p-5 shadow-2xl space-y-5" style="background: #0f172a; border: 1px solid #1e293b;">
            <div class="text-center">
                <div class="inline-flex items-center gap-2 bg-orange-500 text-white text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full mb-2 shadow-md">
                    ⚡ Tiendas NETO Style
                </div>
                <h2 class="text-2xl font-black text-white drop-shadow-md">🛍️ Promociones Neto</h2>
                <p class="text-xs text-blue-200 mt-1">Generador de Prompts Comercial para Imágenes AI</p>
            </div>
            
            <div>
                <label class="block text-xs font-bold text-orange-400 mb-1">Nombre del producto *</label>
                <input type="text" id="prodNombre" placeholder="Ej: Coca-Cola 600ml, Sabritas 3x2, Shampoo Sedal"
                    class="w-full neto-input rounded-xl p-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-orange-500">
            </div>

            <div>
                <label class="block text-xs font-bold text-orange-400 mb-2">🎨 Tipo de Promoción *</label>
                <div class="grid grid-cols-2 gap-2.5" id="gridPromociones">
                    <button type="button" onclick="seleccionarEstilo(this, 'coca')"
                        class="promo-card selected flex flex-col items-start p-3 bg-slate-800 border border-slate-700 rounded-2xl text-left hover:border-red-500 transition text-slate-200">
                        <span class="text-xl mb-1">🥤</span>
                        <span class="text-xs font-bold text-red-400">Coca / Bebida Hielo</span>
                    </button>
                    <button type="button" onclick="seleccionarEstilo(this, 'botanero')"
                        class="promo-card flex flex-col items-start p-3 bg-slate-800 border border-slate-700 rounded-2xl text-left hover:border-amber-500 transition text-slate-200">
                        <span class="text-xl mb-1">🍿</span>
                        <span class="text-xs font-bold text-amber-400">Botanero / 3x2</span>
                    </button>
                    <button type="button" onclick="seleccionarEstilo(this, 'frescura')"
                        class="promo-card flex flex-col items-start p-3 bg-slate-800 border border-slate-700 rounded-2xl text-left hover:border-cyan-600 transition text-slate-200">
